{
    "name": "@ickynavigator/advent-of-code",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "cli": "node ./.cli/index.ts",
        "typecheck": "tsc --project tsconfig.json --noEmit",
        "lint": "biome check",
        "lint:fix": "biome check --write"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@total-typescript/tsconfig": "^1.0.4",
        "@types/node": "^26.6.3",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@clack/prompts": "^1.8.1",
        "chokidar": "^5.0.0",
        "commander": "^15.0.0",
        "simple-git": "^4.0.2",
        "zod": "^4.6.5"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.10.0",
